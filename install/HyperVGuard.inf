; Optional modifying Ethernet LWF. Notify object and kernel gate restrict the target.
[Version]
Signature="$Windows NT$"
Class=NetService
ClassGUID={4D36E974-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=HyperVGuard.cat
DriverVer=10/25/2026,0.3.1.0
PnpLockdown=1

[Manufacturer]
; Driver-store notify-object packages require Windows build 25341 or later.
%Provider%=Models,NTamd64.10.0...25341

[Models.NTamd64.10.0...25341]
%Description%=Install, hyperv_guard

[Install]
Characteristics=0x40000
NetCfgInstanceId="{6E76EAD1-7BCB-49C4-9547-D3E6B3488F71}"
CopyFiles=DriverFiles,NotifyFiles
AddReg=Ndi

[Install.Services]
AddService=HyperVGuard,,Service

[Service]
DisplayName=%Description%
Description=%Help%
ServiceType=1
StartType=1
ErrorControl=1
ServiceBinary=%13%\HyperVGuard.sys
LoadOrderGroup=NDIS

[Ndi]
HKR,Ndi,Service,,"HyperVGuard"
HKR,Ndi,CoServices,0x00010000,"HyperVGuard"
HKR,Ndi,HelpText,,%Help%
HKR,Ndi,FilterClass,,"custom"
HKR,Ndi,FilterType,0x00010001,2
HKR,Ndi,FilterRunType,0x00010001,2
HKR,Ndi,ClsID,,"{1CFED41E-4579-42CF-962C-2A7E04C6DBC8}"
HKR,Ndi,ComponentDll,,"%13%\HyperVGuardNotify.dll"
HKR,Ndi\Interfaces,UpperRange,,"noupper"
HKR,Ndi\Interfaces,LowerRange,,"nolower"
HKR,Ndi\Interfaces,FilterMediaTypes,,"ethernet"

[Install.Remove.Services]
DelService=HyperVGuard,0x200

[DriverFiles]
HyperVGuard.sys,,,2

[NotifyFiles]
HyperVGuardNotify.dll,,,2

[SourceDisksNames]
1=%Description%,,,

[SourceDisksFiles]
HyperVGuard.sys=1
HyperVGuardNotify.dll=1

[DestinationDirs]
DriverFiles=13
NotifyFiles=13

[Strings]
Provider="HyperV Guard Project"
Description="HyperV Guard Rust Host Adapter LWF"
Help="Rust packet verdicts for the Default Switch host vEthernet adapter only."
