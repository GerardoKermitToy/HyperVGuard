function(check_cli executable expected)
    execute_process(COMMAND "${executable}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected exit ${result}, expected ${expected}: ${ARGN}\n${output}\n${error}")
    endif()
    if(expected EQUAL 0)
        if(NOT output MATCHES "Usage:" OR NOT output MATCHES "3010 reboot required" OR
           NOT output MATCHES "invalid arguments do not access WMI")
            message(FATAL_ERROR "Missing offline help/lifecycle contract: ${output}")
        endif()
    elseif(NOT error MATCHES "ERROR:")
        message(FATAL_ERROR "Invalid CLI was not rejected before initialization: ${error}")
    endif()
endfunction()

# Only help or deliberately invalid arguments. Never run an actual action,
# not even --what-if, because that would query the real registry/network stack.
foreach(executable IN ITEMS "${INSTALL}" "${UNINSTALL}")
    check_cli("${executable}" 0 --help)
    check_cli("${executable}" 0 --yes --what-if --help)
    check_cli("${executable}" 0 /?)
    check_cli("${executable}" 2 --unknown)
    check_cli("${executable}" 2 --yes --unknown)
    check_cli("${executable}" 2 HyperVXNdisFilter.sys)
    check_cli("${executable}" 2 --sys HyperVXNdisFilter.sys)
    check_cli("${executable}" 2 --what-if --unknown)
endforeach()
check_cli("${INSTALL}" 0 --enable --help)
check_cli("${INSTALL}" 2 --package)
check_cli("${INSTALL}" 2 --package --yes)
check_cli("${INSTALL}" 2 --package "")
check_cli("${INSTALL}" 2 --package a --package b)
check_cli("${INSTALL}" 2 --enable --package a)
check_cli("${UNINSTALL}" 2 --enable)
check_cli("${UNINSTALL}" 2 --package a)
message(STATUS "Installer/uninstaller help and invalid CLI are offline-safe.")
